# Fitness Coach MCP Example - Environment Variables
# Copy this file to .env and fill in your values

# Required: Google API Key for Gemini models
GOOGLE_API_KEY=your-google-api-key

# Required: Gemini API Key for Agent Memory Server (used in docker-compose.yml)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Agent Memory Server URL (default: http://localhost:8088)
MEMORY_SERVER_URL=http://localhost:8088
