# =============================================================================
# LANGCACHE MEMORY OVER MCP
# =============================================================================
# Copy this file to .env and fill in your actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# Agent model key (REQUIRED to run the ADK agent)
# -----------------------------------------------------------------------------
# The example agent uses Gemini (gemini-2.5-flash), so it needs a Google key.
GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# Langcache memory-dataplane MCP endpoint (REQUIRED)
# -----------------------------------------------------------------------------
# Full URL including the store path: /v1/stores/{storeId}/mcp
# Local in-memory server (from the langcache repo), needs NO LLM key:
#   go run ./memory-dataplane/cmd/mcpstub   # serves on :9100
LANGCACHE_MCP_URL=http://localhost:9100/v1/stores/test-store/mcp

# -----------------------------------------------------------------------------
# Store Bearer token (REQUIRED for a real deployment; omit for the local stub)
# -----------------------------------------------------------------------------
LANGCACHE_MCP_TOKEN=your-store-bearer-token

# -----------------------------------------------------------------------------
# OpenAI API key — SERVER-SIDE ONLY (not consumed by adk-redis)
# -----------------------------------------------------------------------------
# The langcache memory plane generates embeddings (and runs extraction) with an
# OpenAI-protocol key. That key is configured on the langcache SERVER, not here.
# It is listed for convenience if you run your own langcache server locally; the
# in-memory mcpstub does not use it.
OPENAI_API_KEY=your-openai-api-key
