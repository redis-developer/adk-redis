# Gemini Developer API
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_MODEL=gemini-flash-latest
GOOGLE_API_KEY=

# Agent Memory: use a shared root namespace name or a namespace ID.
IRIS_AGENT_MEMORY_URL=
IRIS_AGENT_MEMORY_API_KEY=
IRIS_AGENT_MEMORY_STORE_ID=
IRIS_DEMO_NAMESPACE=adk-iris-support

# Agent Playbooks: use the data-plane base URL.
IRIS_AGENT_PLAYBOOKS_URL=
IRIS_AGENT_PLAYBOOKS_API_KEY=
IRIS_AGENT_PLAYBOOKS_PLAYBOOK_ID=

# Context Gateway: use the full Streamable HTTP MCP endpoint.
IRIS_CONTEXT_GATEWAY_URL=
IRIS_CONTEXT_GATEWAY_API_KEY=

# Intent Router: use the data-plane base URL.
IRIS_INTENT_ROUTER_URL=
IRIS_INTENT_ROUTER_API_KEY=
IRIS_INTENT_ROUTER_ID=

# Lens: use the OTLP ingest endpoint.
IRIS_LENS_ENDPOINT=
IRIS_LENS_API_KEY=

# Optional Agent Mesh beta. Redis 8.6.2 or later with XADD IDMP.
REDIS_URL=redis://127.0.0.1:6386
REDIS_PREFIX=adk-iris-mesh:
