# Copy to .env and fill in.

# Your Gemini API key. Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: override the Redis URL (used by load_data.py).
# REDIS_URL=redis://localhost:6379

# Optional: override the URL the agent uses to reach the rvl mcp server.
# REDISVL_MCP_URL=http://127.0.0.1:8765/mcp

# Optional: bearer token if the rvl mcp server is behind auth.
# REDISVL_MCP_AUTH_TOKEN=
